{
  "name": "translator-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt --check",
    "lint": "oxlint",
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "pnpm wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "pnpm run build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm run lint && pnpm run fmt",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/svelte": "^1.31.0",
    "ai": "^7.0.66",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  }
}

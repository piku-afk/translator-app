{
  "name": "translator-app",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare stack (Workers, D1, R2, Queues) app that translates novels into English chapter by chapter",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest --run",
    "cf:typegen": "wrangler types",
    "routes:typegen": "tsr generate",
    "typegen": "pnpm db:typegen && pnpm cf:typegen && pnpm routes:typegen",
    "check": "tsr generate && tsc --noEmit && pnpm lint",
    "check:watch": "tsr generate && tsc --noEmit --watch",
    "build": "vite build",
    "start": "vite preview",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm cf:typegen && pnpm build && pnpm wrangler deploy",
    "db:typegen": "node scripts/generate-db-types.ts",
    "db:generate": "node scripts/generate-migrations.ts",
    "db:seed:local": "node scripts/seed-greetings.ts --local",
    "db:seed:remote": "node scripts/seed-greetings.ts --remote",
    "db:migrate:local": "pnpm db:generate && wrangler d1 migrations apply translator-prod-db --local && pnpm db:typegen",
    "db:migrate:remote": "pnpm db:generate && wrangler d1 migrations apply translator-prod-db --remote && pnpm db:typegen"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@mantine/core": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.48",
    "ai": "^7.0.70",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.5",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-cli": "^1.167.32",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "better-sqlite3": "^12.11.1",
    "happy-dom": "^20.11.12",
    "jsonc-parser": "^3.3.1",
    "kysely-codegen": "^0.20.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}

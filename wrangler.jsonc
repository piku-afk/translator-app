{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "translator",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "secrets": {
    "required": ["AI_GATEWAY_API_KEY", "AUTH_PASSWORD_HASH", "AUTH_SESSION_SECRET"],
  },
  "vars": {
    "SESSION_MAX_AGE_SECONDS": "86400", // 1 week
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "translator-prod-db",
      "database_id": "9f32cd7d-3f83-4126-9728-2aae56c86af5",
      "migrations_dir": "./d1-migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NOVELS_BUCKET",
      "bucket_name": "translator-prod-novels",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "PARSE_QUEUE",
        "queue": "translator-prod-parse-queue",
      },
    ],
    "consumers": [
      {
        "queue": "translator-prod-parse-queue",
        // Must match PARSE_MAX_RETRIES in src/lib/translator/service.ts: the
        // consumer treats a message on that attempt as exhausted and moves the
        // novel to `failed` instead of retrying again.
        "max_retries": 3,
        "dead_letter_queue": "translator-parse-dlq",
      },
    ],
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}

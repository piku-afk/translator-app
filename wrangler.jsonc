{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "translator",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "secrets": {
    "required": ["AI_GATEWAY_API_KEY", "AUTH_PASSWORD_HASH", "AUTH_SESSION_SECRET"],
  },
  "vars": {
    "SESSION_MAX_AGE_SECONDS": "86400", // 1 week
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "translator",
      "database_id": "d13d5ac6-98c3-47c6-8370-99a93b687a6f",
      "migrations_dir": "./d1-migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NOVELS_BUCKET",
      "bucket_name": "translator-novels",
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "translator",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "secrets": {
    "required": ["AI_GATEWAY_API_KEY", "AUTH_PASSWORD_HASH", "AUTH_SESSION_SECRET"],
  },
  "vars": {
    "SESSION_MAX_AGE_SECONDS": "86400", // 1 week
    "EXTRACTION_MODEL_ID": "tencent/hy3",
    "TRANSLATION_MODEL_ID": "tencent/hy3"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "translator-prod-db",
      "database_id": "9f32cd7d-3f83-4126-9728-2aae56c86af5",
      "migrations_dir": "./d1-migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NOVELS_BUCKET",
      "bucket_name": "translator-prod-novels",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "PARSE_QUEUE",
        "queue": "translator-prod-parse-queue",
      },
      {
        "binding": "EXTRACTION_QUEUE",
        "queue": "translator-prod-extraction-queue",
      },
      {
        "binding": "TRANSLATION_QUEUE",
        "queue": "translator-prod-translation-queue",
      },
      {
        "binding": "RERUN_QUEUE",
        "queue": "translator-prod-rerun-queue",
      },
    ],
    "consumers": [
      {
        "queue": "translator-prod-parse-queue",
        // Must match PARSE_MAX_RETRIES in src/lib/translator/service.ts: the
        // consumer treats a message on that attempt as exhausted and moves the
        // novel to `parsing failed` instead of retrying again.
        "max_retries": 3,
        "dead_letter_queue": "translator-parse-dlq",
      },
      {
        "queue": "translator-prod-extraction-queue",
        // Must match EXTRACTION_MAX_RETRIES in src/lib/translator/service.ts:
        // on exhaustion the novel moves to `extraction failed`.
        "max_retries": 3,
        "dead_letter_queue": "translator-extraction-dlq",
      },
      {
        "queue": "translator-prod-translation-queue",
        // Must match TRANSLATION_MAX_RETRIES in src/lib/translator/service.ts:
        // on exhaustion the novel moves to `translation failed`.
        "max_retries": 3,
        "dead_letter_queue": "translator-translation-dlq",
      },
      {
        "queue": "translator-prod-rerun-queue",
        // Must match RERUN_MAX_RETRIES in src/lib/translator/service.ts:
        // on exhaustion the chapter moves to `failed`.
        "max_retries": 3,
        "dead_letter_queue": "translator-rerun-dlq",
      },
    ],
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}

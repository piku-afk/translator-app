{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "translator",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "secrets": {
    "required": [
      "AI_GATEWAY_API_KEY",
      "AUTH_PASSWORD_HASH",
      "AUTH_SESSION_SECRET",
      "SESSION_MAX_AGE_SECONDS",
    ],
  },
}

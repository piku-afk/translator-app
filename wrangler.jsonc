{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "translator",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "secrets": {
    "required": ["AI_GATEWAY_API_KEY", "AUTH_PASSWORD_HASH", "AUTH_SESSION_SECRET"],
  },
  "vars": {
    "SESSION_MAX_AGE_SECONDS": "86400", // 1 week
  },
}
